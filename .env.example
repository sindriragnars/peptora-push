# VAPID — generated once via `npx web-push generate-vapid-keys`.
# Public key is safe to expose; private MUST stay server-side only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identifies us to push services if delivery fails (e.g. they email us).
VAPID_SUBJECT=mailto:info@peptora.app

# Upstash Redis — provisioned from Vercel marketplace.
# The Storage integration drops these in automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash — message queue for scheduled reminder pushes.
# Also provisioned from Vercel marketplace; the integration injects
# the token + both signing keys (current rotates, next is queued for
# next rotation cycle).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Shared secret protecting the internal /api/push endpoint.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_PUSH_SECRET=

# CORS allowlist — comma-separated origins. Defaults to app.peptora.app
# for production. Add http://localhost:5173 during dev if needed.
ALLOWED_ORIGINS=https://app.peptora.app
